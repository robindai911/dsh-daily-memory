{
  "name": "dsh-daily-memory",
  "version": "0.1.0",
  "description": "Daily reflection and long-term memory for DeepSeek Harness: reviews past sessions, distils durable notes into local markdown, retrieves only the few that matter.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": ["dsh", "deepseek-harness", "memory", "plugin", "agent"],
  "license": "MIT",
  "engines": { "node": ">=22" }
}
